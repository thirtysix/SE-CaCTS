# SE-CaCTS — machine-local configuration.
#
#   cp sample.env .env      then edit .env for your machine.
#
# `.env` is gitignored and must stay that way: it is the only place a local filesystem
# layout or an HPC allocation id should appear. Nothing in the tracked tree may hardcode
# either.
#
# Both loaders read this file:
#   Python  from secacts_env import DATAROOT, CSC_PROJECT, CACHE_DIR
#   Shell   . "$SECACTS/secacts_env.sh"
# Real environment variables win over `.env`, so CI and one-off overrides work:
#   SECACTS_DATAROOT=/data/mirror python phase2/score_pilot.py ...


# ---------------------------------------------------------------------------
# REQUIRED — the parent directory holding the shared reference datasets.
# ---------------------------------------------------------------------------
# SE-CaCTS does not vendor these; they are large, shared with sibling projects, and
# fetched separately (see DATA_SOURCES.md). The layout expected underneath:
#
#   $SECACTS_DATAROOT/
#     DepMap/2026q1/OmicsCNGeneWGS.csv                  copy number (the CN correction input)
#     DepMap/2026q1/OmicsExpressionTPMLogp1HumanProteinCodingGenes.csv
#     DepMap/2026q1/Model.csv                           Oncotree lineage / disease / subtype
#     chip-atlas/experimentList.tab                     authoritative ChIP-Atlas metadata
#     chip-atlas/00.data/Histone/His.ALL.50.H3K27ac.AllCell.bed.gz
#     cellosaurus/cellosaurus.txt                       the CVCL name bridge
#     0.human_genome/Homo_sapiens.GRCh38.106.chr.gtf.gz gene coordinates
#     002.AI_projects/pyCaCTS/                          the sibling JSD engine (importable)
#
SECACTS_DATAROOT=/path/to/your/datasets


# ---------------------------------------------------------------------------
# OPTIONAL — CSC (or any SLURM) allocation, only for the Phase-2 pull on HPC.
# ---------------------------------------------------------------------------
# Everything downstream of the atlas runs locally and never needs this.
# The SLURM scripts export it as SBATCH_ACCOUNT rather than hardcoding
# `#SBATCH --account=`, so the account travels in the environment.
#
#SECACTS_CSC_PROJECT=project_0000000

# Where the pull writes on the cluster. Defaults to /scratch/$SECACTS_CSC_PROJECT/se-cacts
#SECACTS_SCRATCH=/scratch/project_0000000/se-cacts


# ---------------------------------------------------------------------------
# OPTIONAL — local overrides
# ---------------------------------------------------------------------------
# Parsed-once caches (gene coordinates, etc.). Defaults to <repo>/.cache, gitignored.
#SECACTS_CACHE_DIR=/var/tmp/se-cacts-cache

# Python interpreter used by the shell drivers. Needs pyBigWig+numpy+scipy+pandas.
#SECACTS_PY=$HOME/miniconda3/envs/atac_hdac/bin/python
